                <Grid x:Name="PanelPrivacy" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Privacy Eraser" Style="{StaticResource TitleHeaderStyle}" />
                            <TextBlock Text="Clear recent files, search history, clipboard, and system traces." Style="{StaticResource SubtitleHeaderStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Style="{StaticResource VortexSecondaryButton}" Content="🔍 Scan Traces" Click="OnScanPrivacyClick" Height="34" Padding="14,0" Margin="0,0,8,0" />
                            <Button Style="{StaticResource VortexDangerButton}" Content="🧹 Erase Selected" Click="OnErasePrivacyClick" Height="34" Padding="16,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="PbPrivacyScan" Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,0,0,10" Visibility="Collapsed" Foreground="{DynamicResource AccentPrimaryBrush}" Background="Transparent" />

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                        <ListView x:Name="LvPrivacy">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="26">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Trace Category" Width="180" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Risk" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding RiskBadgeColor}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding RiskBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Items" Width="70" DisplayMemberBinding="{Binding ItemCount}" />
                                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeString}" />
                                    <GridViewColumn Header="Description" Width="420" DisplayMemberBinding="{Binding Description}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <!-- TAB 10: Identity Shield -->
                <Grid x:Name="PanelIdentity" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Identity Shield" Style="{StaticResource TitleHeaderStyle}" />
                            <TextBlock Text="Scan local credential stores, Wi-Fi profiles, and SSH keys." Style="{StaticResource SubtitleHeaderStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Row="1" Style="{StaticResource VortexSecondaryButton}" Content="🔍 Scan Identity Exposure" Click="OnScanIdentityClick" Height="34" Padding="14,0" HorizontalAlignment="Right" Margin="0,8,0,0" />
                    </Grid>

                    <ProgressBar x:Name="PbIdentityScan" Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,0,0,6" Visibility="Collapsed" Foreground="{DynamicResource AccentPrimaryBrush}" Background="Transparent" />

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <TextBlock Text="🔒 Identity Shield is read-only — it scans and reports. Use the Action button on each finding to manage it in the appropriate native tool." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="3" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                        <ListView x:Name="LvIdentity">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Category" Width="140" DisplayMemberBinding="{Binding Category}" />
                                    <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Risk" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding RiskBadgeColor}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding RiskBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Detail" Width="240" DisplayMemberBinding="{Binding Detail}" />
                                    <GridViewColumn Header="Action" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ActionLabel}" Style="{StaticResource VortexSecondaryButton}" Click="OnIdentityActionClick" Tag="{Binding ActionTarget}" Padding="8,3" FontSize="11" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <!-- TAB 10B: Data Shield & Zero-Trust File Vault -->
                <Grid x:Name="PanelVault" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header & Master Controls -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Data Shield &amp; Zero-Trust Vault" Style="{StaticResource TitleHeaderStyle}" />
                            <TextBlock Text="Lock directories with AES-256-GCM, enable stealth invisibility, and prevent unauthorized USB file copying." Style="{StaticResource SubtitleHeaderStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnVaultSetupMaster" Style="{StaticResource VortexSecondaryButton}" Content="🔑 Master Security" Click="OnVaultSetupMasterClick" Margin="0,0,8,0" Height="32" ToolTip="Configure Master Password and Emergency Recovery Key" />
                            <Button x:Name="BtnVaultLockAll" Style="{StaticResource VortexDangerButton}" Content="🔒 Lock All Vaults" Click="OnVaultLockAllClick" Height="32" ToolTip="Immediately seal and hide all protected directories" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Telemetry & Status Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Protected Vaults -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="📁 PROTECTED VAULTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtVaultCount" Text="0 Vaults" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtVaultCountSub" Text="0 Locked | 0 Unlocked" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Total Encrypted Data -->
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="🔐 ENCRYPTED STORAGE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtVaultTotalSize" Text="0 MB" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtVaultFilesSub" Text="0 Total Files Protected" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: USB DLP Guard -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="💾 USB DATA LOSS GUARD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtVaultUsbStatus" Text="🔓 Standard (Write Allowed)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TxtVaultUsbSub" Text="Click to enforce Read-Only" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Auto-Lock Sentinel -->
                        <Border Grid.Column="3" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="⏱️ AUTO-LOCK SENTINEL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtVaultAutoLockStatus" Text="🛡️ Active (Win+L / 15m)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource StatusSafeBrush}" Margin="0,4,0,0" />
                                <TextBlock x:Name="TxtVaultAutoLockSub" Text="Seals on sleep or lock" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Segmented Sub-Tab Bar -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <RadioButton x:Name="SubTabVaultFolders" Style="{StaticResource SidebarRadioButton}" Content="📁 Protected Folders &amp; Vaults (0)" IsChecked="True" Checked="OnVaultSubTabChanged" Margin="0,0,8,0" Height="32" Width="230" />
                            <RadioButton x:Name="SubTabVaultUsb" Style="{StaticResource SidebarRadioButton}" Content="💾 USB &amp; External Media Guard (DLP)" Checked="OnVaultSubTabChanged" Margin="0,0,8,0" Height="32" Width="250" />
                            <RadioButton x:Name="SubTabVaultSettings" Style="{StaticResource SidebarRadioButton}" Content="⚙️ Security &amp; Auto-Lock Settings" Checked="OnVaultSubTabChanged" Margin="0,0,8,0" Height="32" Width="220" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Dynamic Sub-Views Container -->
                    <Grid Grid.Row="3">
                        <!-- VIEW 1: Protected Folders List -->
                        <Grid x:Name="ViewVaultFolders" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Grid DockPanel.Dock="Left" Width="300">
                                    <TextBox x:Name="TxtVaultFilter" Style="{StaticResource FluentSearchBox}"
                                             Padding="10,6,28,6" Height="32"
                                             TextChanged="OnVaultFilterChanged"
                                             ToolTip="Filter protected folders by name or path" />
                                    <TextBlock x:Name="TxtVaultFilterPlaceholder" Text="Filter protected folders..."
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               IsHitTestVisible="False" FontSize="11" />
                                    <TextBlock Text="🔍" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,10,0" IsHitTestVisible="False" FontSize="11" />
                                </Grid>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource VortexSecondaryButton}" Content="🔄 Refresh" Click="OnVaultRefreshClick" Margin="0,0,8,0" Height="32" />
                                    <Button Style="{StaticResource VortexPrimaryButton}" Content="➕ Add Folder to Vault..." Click="OnVaultAddFolderClick" Height="32" ToolTip="Select any directory on your computer to encrypt and protect" />
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                                <ListView x:Name="LvVaultFolders" SelectionMode="Single">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Folder &amp; Path" Width="260">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding FolderPath}">
                                                            <TextBlock Text="{Binding IconGlyph}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FolderPath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Size &amp; Files" Width="130">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SizeFormatted}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" />
                                                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0:N0} files'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Protection Mode" Width="140">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ModeDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Status" Width="180">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="#18FFFFFF" BorderThickness="1">
                                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusBadgeColor}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Quick Actions" Width="240">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Toggle Lock/Unlock -->
                                                            <Button Style="{StaticResource VortexPrimaryButton}" Click="OnVaultToggleLockRowClick" Padding="8,3" FontSize="10.5" Margin="0,0,4,0">
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="🔒 Lock" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                                    <Setter Property="Text" Value="🔓 Unlock" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>

                                                            <!-- Toggle Stealth Mode -->
                                                            <Button Style="{StaticResource VortexSecondaryButton}" Click="OnVaultToggleStealthRowClick" Padding="6,3" FontSize="10.5" Margin="0,0,4,0" ToolTip="Switch between Invisible (Stealth) and Visible (Locked) mode">
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="👻 Stealth" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsStealth}" Value="True">
                                                                                    <Setter Property="Text" Value="👁️ Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>

                                                            <!-- Open in Explorer -->
                                                            <Button Style="{StaticResource VortexSecondaryButton}" Content="📂 Open" Click="OnVaultOpenFolderRowClick" Padding="6,3" FontSize="10.5" Margin="0,0,4,0" ToolTip="Open folder in Windows File Explorer" />

                                                            <!-- Remove from Vault -->
                                                            <Button Style="{StaticResource VortexSecondaryButton}" Content="🗑️" Click="OnVaultRemoveRowClick" Padding="6,3" FontSize="10.5" Foreground="{DynamicResource StatusDangerBrush}" ToolTip="Remove from Vault protection and restore unencrypted" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>

                        <!-- VIEW 2: USB & Removable Media Guard (DLP) -->
                        <Grid x:Name="ViewVaultUsb" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Hero Master USB Switch Card -->
                            <Border Grid.Row="0" CornerRadius="10" Padding="20,16" Margin="0,0,0,12" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentGlowBrush}" Margin="0,0,16,0">
                                        <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Removable Media Copy-Protection (DLP)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                            <Border CornerRadius="4" Padding="6,2" Background="#20000000">
                                                <TextBlock x:Name="TxtUsbPolicyBadge" Text="STATUS: UNPROTECTED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Enforces low-level Windows kernel Read-Only policy on all USB thumb drives, SD cards, and external HDDs/SSDs to prevent file theft and unauthorized copy/paste."
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="620" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="BtnToggleUsbWriteBlock" Style="{StaticResource VortexPrimaryButton}" Content="🔒 Enable USB Write-Block" Click="OnToggleUsbWriteBlockClick" Height="36" Padding="16,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Temporary Write Authorization Window Card -->
                            <Border Grid.Row="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="⏱️ Temporary Write Authorization Window" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtUsbCountdown" Text="Need to copy legitimate files to a USB? Authorize a timed write window with your Master Password." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource VortexSecondaryButton}" Content="⏱️ 5 Minutes" Click="OnAuthorizeUsb5MinClick" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                                        <Button Style="{StaticResource VortexSecondaryButton}" Content="⏱️ 15 Minutes" Click="OnAuthorizeUsb15MinClick" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                                        <Button Style="{StaticResource VortexSecondaryButton}" Content="⏱️ 30 Minutes" Click="OnAuthorizeUsb30MinClick" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                                        <Button x:Name="BtnLockUsbNow" Style="{StaticResource VortexDangerButton}" Content="🔒 Lock USB Now" Click="OnLockUsbNowClick" Padding="10,4" FontSize="11" Visibility="Collapsed" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Connected Removable Drives Table -->
                            <Border Grid.Row="2" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                                <ListView x:Name="LvRemovableDrives" SelectionMode="Single">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Connected Drive" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                                                                <TextBlock Text="{Binding DriveFormat, StringFormat='Format: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Capacity &amp; Free Space" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding SizeFormatted, StringFormat='Capacity: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Write-Protection Status" Width="240">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Background="#18FFFFFF" BorderThickness="1">
                                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusBadgeColor}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>

                        <!-- VIEW 3: Security & Auto-Lock Settings -->
                        <Grid x:Name="ViewVaultSettings" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                    <!-- Group 1: Master Security Credentials -->
                                    <TextBlock Text="MASTER SECURITY CREDENTIALS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" Margin="0,0,0,8" />
                                    <Border Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="Master Password &amp; Encryption Key" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="Controls folder locking and USB write authorizations via PBKDF2 + AES-256-GCM." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Style="{StaticResource VortexSecondaryButton}" Content="🔑 Change Password" Click="OnChangeVaultPasswordClick" DockPanel.Dock="Right" Height="30" Padding="12,0" />
                                            </DockPanel>
                                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="Emergency 24-Character Recovery Key" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="Used to restore access if you ever forget your Master Password." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Style="{StaticResource VortexSecondaryButton}" Content="📋 View Recovery Key" Click="OnViewRecoveryKeyClick" DockPanel.Dock="Right" Height="30" Padding="12,0" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 2: Auto-Lock Sentinel Policies -->
                                    <TextBlock Text="AUTO-LOCK SENTINEL POLICIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" Margin="0,0,0,8" />
                                    <Border Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkVaultLockOnScreenLock" Style="{StaticResource ModernCheckBox}" Content="Auto-Lock all vaults when Windows locks (Win + L) or screen sleeps" Click="OnVaultAutoLockPolicyChanged" Margin="0,0,0,12" />
                                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="Inactivity Auto-Lock Timeout" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="Automatically seal all open vaults after a period of no keyboard/mouse input." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <ComboBox x:Name="CmbVaultIdleMinutes" Width="140" Height="30" DockPanel.Dock="Right" SelectionChanged="OnVaultIdleMinutesChanged">
                                                    <ComboBoxItem Content="5 Minutes" Tag="5" />
                                                    <ComboBoxItem Content="15 Minutes" Tag="15" />
                                                    <ComboBoxItem Content="30 Minutes" Tag="30" />
                                                    <ComboBoxItem Content="60 Minutes" Tag="60" />
                                                    <ComboBoxItem Content="Disabled (Never)" Tag="0" />
                                                </ComboBox>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 3: Windows Explorer Integration -->
                                    <TextBlock Text="WINDOWS EXPLORER RIGHT-CLICK INTEGRATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" Margin="0,0,0,8" />
                                    <Border Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkVaultContextMenu" Style="{StaticResource ModernCheckBox}" Content="Show '🛡️ Vortex: Protect &amp; Lock Folder' in Windows File Explorer right-click menu" Click="OnVaultContextMenuPolicyChanged" />
                                            <TextBlock Text="Allows right-clicking any folder on your drive to instantly lock or stealth-hide it." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- TAB 11: Software Updater -->
                <Grid x:Name="PanelUpdater" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Software Updater" Style="{StaticResource TitleHeaderStyle}" />
                            <TextBlock Text="Keep installed applications updated via winget." Style="{StaticResource SubtitleHeaderStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Style="{StaticResource VortexSecondaryButton}" Content="☑ Select All Known" Click="OnSelectAllKnownClick" Height="34" Padding="14,0" Margin="0,0,8,0" />
                            <Button Style="{StaticResource VortexSecondaryButton}" Content="🔍 Check for Updates" Click="OnCheckUpdatesClick" Height="34" Padding="14,0" Margin="0,0,8,0" />
                            <Button x:Name="BtnCleanCache" Style="{StaticResource VortexSecondaryButton}" Content="🧹 Clear Cache" Click="OnCleanDownloadCacheClick" Height="34" Padding="14,0" Margin="0,0,8,0" ToolTip="Deletes temporary installer files left behind by winget to free up disk space." />
                            <Button x:Name="BtnStopUpdater" Style="{StaticResource VortexDangerButton}" Content="⏹ Stop Update" Click="OnStopUpdateClick" Height="34" Padding="16,0" Margin="0,0,8,0" Visibility="Collapsed" FontWeight="SemiBold" />
                            <Button x:Name="BtnUpdateSelected" Style="{StaticResource VortexPrimaryButton}" Content="🚀 Update Selected" Click="OnUpdateSelectedClick" Height="34" Padding="16,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="PbUpdaterScan" Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,0,0,10" Visibility="Collapsed" Foreground="{DynamicResource AccentPrimaryBrush}" Background="Transparent" />

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,10">
                        <ListView x:Name="LvUpdater" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="46">
                                        <GridViewColumn.Header>
                                            <CheckBox x:Name="ChkSelectAllHeader" Click="OnSelectAllHeaderClick" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Select / Deselect All Known" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Application" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Package ID" Width="210">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Current" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CurrentVer}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Latest" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LatestVer}" FontWeight="Medium" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="4,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Status" Width="95">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Active Update Progress Card -->
                    <Border x:Name="BorderUpdaterProgress" Grid.Row="3" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Overall Progress Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock x:Name="TxtOverallProgressTitle" Text="Overall Progress" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtOverallProgressPercent" Text="0%" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" />
                            </Grid>
                            <ProgressBar x:Name="PbOverallProgress" Grid.Row="1" Height="6" Maximum="100" Value="0" Foreground="{DynamicResource AccentPrimaryBrush}" Background="#1F1F2E" Margin="0,0,0,12" />

                            <!-- Current Package Download/Install Progress Header -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <TextBlock x:Name="TxtPackageProgressTitle" Text="Download &amp; Install Progress" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtPackageProgressDetail" Text="" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <ProgressBar x:Name="PbPackageProgress" Grid.Row="3" Height="8" Maximum="100" Value="0" Foreground="#00E599" Background="#1F1F2E" />
                        </Grid>
                    </Border>

                    <!-- Live Terminal Output -->
                    <Border Grid.Row="4" x:Name="BorderUpdaterTerminal" Background="#0A0A0F" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed">
                        <ScrollViewer x:Name="SvUpdaterOutput" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtUpdaterOutput" FontFamily="Consolas" FontSize="12" Foreground="#00E599" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="TxtUpdaterStatus" Grid.Row="5" Text="Ready — click 'Check for Updates' to discover available upgrades." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" />
                </Grid>

                <!-- TAB 12: System Info -->
                <Grid x:Name="PanelSysInfo" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="System Information" Style="{StaticResource TitleHeaderStyle}" />
                            <TextBlock Text="Hardware specifications and live sensor telemetry." Style="{StaticResource SubtitleHeaderStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Style="{StaticResource VortexSecondaryButton}" Content="📄 Export TXT" Click="OnExportSysInfoClick" Height="34" Padding="14,0" Margin="0,0,8,0" />
                            <Button Style="{StaticResource VortexSecondaryButton}" Content="🔄 Refresh" Click="OnRefreshSysInfoClick" Height="34" Padding="14,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Live Sensor Cards Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Card -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="⚡ CPU" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="TxtCpuTemp" Text="— °C" Foreground="{DynamicResource AccentGlowBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,2" />
                                <TextBlock x:Name="TxtCpuUsage" Text="Usage: —%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- GPU Card -->
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="🎮 GPU" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="TxtGpuTemp" Text="— °C" Foreground="{DynamicResource AccentGlowBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,2" />
                                <TextBlock x:Name="TxtGpuUsage" Text="Usage: —%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Disk Card -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="💾 DISK" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="TxtDiskTemp" Text="— °C" Foreground="{DynamicResource AccentGlowBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,2" />
                                <TextBlock x:Name="TxtMbTemp" Text="MB: — °C" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- RAM Card -->
                        <Border Grid.Column="3" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="🧠 RAM" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="TxtSysRamPct" Text="—%" Foreground="{DynamicResource AccentGlowBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,2" />
                                <TextBlock x:Name="TxtSysRamUsed" Text="— / — GB" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Tab Strip for spec categories -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="SysTabCpu"  GroupName="SysInfoTab" Content="CPU"         Style="{StaticResource FluentNavItem}" IsChecked="True" Checked="OnSysInfoTabChanged" Padding="12,6" />
                        <RadioButton x:Name="SysTabGpu"  GroupName="SysInfoTab" Content="GPU"         Style="{StaticResource FluentNavItem}" Checked="OnSysInfoTabChanged" Padding="12,6" />
                        <RadioButton x:Name="SysTabRam"  GroupName="SysInfoTab" Content="Memory"      Style="{StaticResource FluentNavItem}" Checked="OnSysInfoTabChanged" Padding="12,6" />
                        <RadioButton x:Name="SysTabDisk" GroupName="SysInfoTab" Content="Storage"     Style="{StaticResource FluentNavItem}" Checked="OnSysInfoTabChanged" Padding="12,6" />
                        <RadioButton x:Name="SysTabMb"   GroupName="SysInfoTab" Content="Motherboard" Style="{StaticResource FluentNavItem}" Checked="OnSysInfoTabChanged" Padding="12,6" />
                        <RadioButton x:Name="SysTabOs"   GroupName="SysInfoTab" Content="OS &amp; Software" Style="{StaticResource FluentNavItem}" Checked="OnSysInfoTabChanged" Padding="12,6" />
                    </StackPanel>

                    <!-- Spec Table -->
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                        <ListView x:Name="LvSysInfo">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Property" Width="260" DisplayMemberBinding="{Binding Property}" />
                                    <GridViewColumn Header="Value" Width="650" DisplayMemberBinding="{Binding Value}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- 3. Slim Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusBar" Text="Vortex Fluent Engine Ready • Administrator Elevated" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
