<Window x:Class="Vortex.Views.VortexDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vortex"
        Width="460" Height="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DeepSpaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="16"
            Background="{DynamicResource SurfaceDarkBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" Color="#000000" Opacity="0.65" ShadowDepth="6" />
        </Border.Effect>

        <Grid>
            <!-- Top Subtle Atmospheric Gradient Glow -->
            <Border Height="80" VerticalAlignment="Top" CornerRadius="16,16,0,0" Opacity="0.4"
                    Background="{DynamicResource AtmosphericGradient}" IsHitTestVisible="False" />

            <DockPanel Margin="22,18,22,20">
                <!-- Header / Titlebar -->
                <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/vortex.png" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="TxtCategory" Text="VORTEX INTELLIGENCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WindowCaptionButton}" Content="✕" Width="28" Height="28" Click="OnCloseClick" HorizontalAlignment="Right" />
                </DockPanel>

                <!-- Action Button Row at Bottom -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnCancel" Style="{StaticResource VortexSecondaryButton}" Content="Cancel" MinWidth="90" Padding="14,6" Margin="0,0,10,0" Click="OnCancelClick" Visibility="Collapsed" />
                    <Button x:Name="BtnOk" Style="{StaticResource VortexPrimaryButton}" Content="Done" MinWidth="110" Padding="16,6" Click="OnOkClick" />
                </StackPanel>

                <!-- Center Content Body -->
                <StackPanel VerticalAlignment="Center">
                    <!-- Icon + Title Row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border x:Name="BorderIcon" Width="44" Height="44" CornerRadius="22" Background="#2000E599" BorderBrush="{DynamicResource StatusSafeBrush}" BorderThickness="1.5" Margin="0,0,14,0">
                            <TextBlock x:Name="TxtIcon" Text="✓" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource StatusSafeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitle" Text="Turbo Boost Complete" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="TxtSubtitle" Text="System memory optimization completed successfully." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Metric Callout Card -->
                    <Border x:Name="BorderMetricCard" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,4,0,10">
                        <DockPanel>
                            <TextBlock x:Name="TxtMetricValue" DockPanel.Dock="Left" Text="+ 1.44 GB" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource StatusSafeBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMetricLabel" Text="RAM Reclaimed" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtMetricSubtext" Text="Dormant process working sets flushed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Detailed Message Text -->
                    <TextBlock x:Name="TxtMessage" Text="Vortex successfully flushed working sets across all running applications. RAM is now freed for high-demand tasks and gaming." 
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
