<Window x:Class="Vortex.Views.VaultPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vortex Vault Security"
        Width="440" Height="330"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DeepSpaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="16"
            Background="{DynamicResource SurfaceDarkBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" Color="#000000" Opacity="0.7" ShadowDepth="6" />
        </Border.Effect>

        <Grid>
            <!-- Top Subtle Atmospheric Gradient Glow -->
            <Border Height="80" VerticalAlignment="Top" CornerRadius="16,16,0,0" Opacity="0.4"
                    Background="{DynamicResource AtmosphericGradient}" IsHitTestVisible="False" />

            <DockPanel Margin="22,18,22,20">
                <!-- Header / Titlebar -->
                <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtHeader" Text="VORTEX ZERO-TRUST VAULT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WindowCaptionButton}" Content="✕" Width="28" Height="28" Click="OnCancelClick" HorizontalAlignment="Right" />
                </DockPanel>

                <!-- Action Buttons at Bottom -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button x:Name="BtnUseRecoveryKey" DockPanel.Dock="Left" Style="{StaticResource VortexSecondaryButton}" Content="🔑 Use Recovery Key" FontSize="10.5" Padding="10,4" Click="OnToggleRecoveryKeyClick" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource VortexSecondaryButton}" Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancelClick" />
                        <Button x:Name="BtnSubmit" Style="{StaticResource VortexPrimaryButton}" Content="Unlock" Width="100" Click="OnSubmitClick" IsDefault="True" />
                    </StackPanel>
                </DockPanel>

                <!-- Content Body -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Authentication Required" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtPrompt" Text="Enter your Master Password to access this protected folder or authorize external write access." 
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <!-- Password Box Mode -->
                    <Grid x:Name="GridPasswordBox" Margin="0,0,0,8">
                        <PasswordBox x:Name="PbPassword" Style="{StaticResource FluentPasswordBox}" Height="36" Padding="10,6" FontSize="13" />
                    </Grid>

                    <!-- Recovery Key Input Mode (Alternate) -->
                    <Grid x:Name="GridRecoveryKey" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBox x:Name="TxtRecoveryKey" Style="{StaticResource FluentSearchBox}" Height="36" Padding="10,6" FontSize="12"
                                 ToolTip="Enter 24-character recovery key (e.g. VRTX-XXXX-XXXX-XXXX-XXXX-XXXX)" />
                    </Grid>

                    <!-- Error Text Banner -->
                    <TextBlock x:Name="TxtError" Text="" Foreground="{DynamicResource StatusDangerBrush}" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
