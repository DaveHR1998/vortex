<Window x:Class="Vortex.Views.VaultSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vortex Vault Security Setup"
        Width="500" Height="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DeepSpaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="16"
            Background="{DynamicResource SurfaceDarkBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.75" ShadowDepth="6" />
        </Border.Effect>

        <Grid>
            <!-- Top Subtle Atmospheric Gradient Glow -->
            <Border Height="80" VerticalAlignment="Top" CornerRadius="16,16,0,0" Opacity="0.4"
                    Background="{DynamicResource AtmosphericGradient}" IsHitTestVisible="False" />

            <DockPanel Margin="24,20,24,22">
                <!-- Header / Titlebar -->
                <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="ZERO-TRUST MASTER SECURITY SETUP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WindowCaptionButton}" Content="✕" Width="28" Height="28" Click="OnCancelClick" HorizontalAlignment="Right" />
                </DockPanel>

                <!-- Action Button at Bottom -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource VortexSecondaryButton}" Content="Cancel" Width="90" Margin="0,0,10,0" Click="OnCancelClick" />
                    <Button x:Name="BtnCompleteSetup" Style="{StaticResource VortexPrimaryButton}" Content="Activate Security" Width="140" Click="OnCompleteSetupClick" />
                </StackPanel>

                <!-- Body Content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Protect Your Files &amp; External Media" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Configure your Master Password to lock directories, enable stealth mode, and control USB device copy protection." 
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <!-- Step 1: Passwords -->
                        <TextBlock Text="STEP 1: CHOOSE MASTER PASSWORD" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <PasswordBox x:Name="PbPassword" Style="{StaticResource FluentPasswordBox}" Height="34" Padding="10,6" FontSize="12.5" />
                        </Grid>
                        
                        <TextBlock Text="CONFIRM MASTER PASSWORD" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,6" />
                        <Grid Margin="0,0,0,14">
                            <PasswordBox x:Name="PbConfirmPassword" Style="{StaticResource FluentPasswordBox}" Height="34" Padding="10,6" FontSize="12.5" />
                        </Grid>

                        <!-- Step 2: Emergency Recovery Key -->
                        <TextBlock Text="STEP 2: EMERGENCY RECOVERY KEY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="If you ever forget your password, this 24-character key is the ONLY way to recover your encrypted files." 
                                           FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                
                                <DockPanel>
                                    <TextBox x:Name="TxtRecoveryKeyDisplay" IsReadOnly="True" FontWeight="Bold" FontSize="13" 
                                             Background="#15000000" Foreground="{DynamicResource AccentPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,5" Height="32" />
                                </DockPanel>

                                <Button Style="{StaticResource VortexSecondaryButton}" Content="📋 Copy Recovery Key" Margin="0,8,0,0" Padding="10,4" HorizontalAlignment="Left" Click="OnCopyRecoveryKeyClick" />
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkKeySaved" Style="{StaticResource ModernCheckBox}" Content="I have saved or written down my Emergency Recovery Key." Margin="0,4,0,10" />

                        <TextBlock x:Name="TxtError" Text="" Foreground="{DynamicResource StatusDangerBrush}" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
