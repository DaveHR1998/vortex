<Window x:Class="Vortex.Views.VaultChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Master Password"
        Width="480" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DeepSpaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="16"
            Background="{DynamicResource SurfaceDarkBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.75" ShadowDepth="6" />
        </Border.Effect>

        <Grid>
            <!-- Top Atmospheric Gradient Glow -->
            <Border Height="80" VerticalAlignment="Top" CornerRadius="16,16,0,0" Opacity="0.4"
                    Background="{DynamicResource AtmosphericGradient}" IsHitTestVisible="False" />

            <DockPanel Margin="24,20,24,22">
                <!-- Header / Titlebar -->
                <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔑" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="CHANGE MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WindowCaptionButton}" Content="✕" Width="28" Height="28" Click="OnCancelClick" HorizontalAlignment="Right" />
                </DockPanel>

                <!-- Action Buttons at Bottom -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button x:Name="BtnUseRecoveryKey" DockPanel.Dock="Left" Style="{StaticResource VortexSecondaryButton}" Content="🛡️ Use Recovery Key" FontSize="10.5" Padding="10,4" Click="OnToggleRecoveryKeyClick" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource VortexSecondaryButton}" Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancelClick" />
                        <Button x:Name="BtnUpdate" Style="{StaticResource VortexPrimaryButton}" Content="Update Password" Width="140" Click="OnUpdateClick" IsDefault="True" />
                    </StackPanel>
                </DockPanel>

                <!-- Content Body -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Update Master Credentials" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Re-wraps your Vault Master Key. All existing locked files and folders will stay protected and unlockable." 
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Step 1: Current Credential -->
                        <TextBlock x:Name="LblCurrentCred" Text="CURRENT MASTER PASSWORD" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                        <Grid x:Name="GridCurrentPassword" Margin="0,0,0,12">
                            <PasswordBox x:Name="PbCurrentPassword" Style="{StaticResource FluentPasswordBox}" Height="34" Padding="10,6" FontSize="12.5" />
                        </Grid>
                        <Grid x:Name="GridCurrentRecovery" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBox x:Name="TxtCurrentRecoveryKey" Style="{StaticResource FluentSearchBox}" Height="34" Padding="10,6" FontSize="12"
                                     ToolTip="Enter 24-character Emergency Recovery Key (e.g. VRTX-XXXX-XXXX-XXXX-XXXX-XXXX)" />
                        </Grid>

                        <!-- Step 2: New Password -->
                        <TextBlock Text="NEW MASTER PASSWORD (MIN 6 CHARACTERS)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <PasswordBox x:Name="PbNewPassword" Style="{StaticResource FluentPasswordBox}" Height="34" Padding="10,6" FontSize="12.5" />
                        </Grid>

                        <!-- Step 3: Confirm New Password -->
                        <TextBlock Text="CONFIRM NEW MASTER PASSWORD" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <PasswordBox x:Name="PbConfirmPassword" Style="{StaticResource FluentPasswordBox}" Height="34" Padding="10,6" FontSize="12.5" />
                        </Grid>

                        <!-- Error Text Banner -->
                        <TextBlock x:Name="TxtError" Text="" Foreground="{DynamicResource StatusDangerBrush}" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
