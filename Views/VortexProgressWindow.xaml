<Window x:Class="Vortex.Views.VortexProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vortex"
        Width="520" Height="340"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DeepSpaceTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="16"
            Background="{DynamicResource SurfaceDarkBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" Color="#000000" Opacity="0.65" ShadowDepth="6" />
        </Border.Effect>

        <Grid>
            <!-- Top Subtle Atmospheric Gradient Glow -->
            <Border Height="80" VerticalAlignment="Top" CornerRadius="16,16,0,0" Opacity="0.4"
                    Background="{DynamicResource AtmosphericGradient}" IsHitTestVisible="False" />

            <DockPanel Margin="26,18,26,22">

                <!-- Header -->
                <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/vortex.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="TxtCategory" Text="CLEANING IN PROGRESS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- Close Button at Bottom — only visible when done -->
                <Button x:Name="BtnClose"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource VortexPrimaryButton}"
                        Content="Close"
                        Width="120"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Visibility="Collapsed"
                        Click="OnCloseClick" />

                <!-- Body -->
                <StackPanel VerticalAlignment="Center">

                    <!-- Icon + Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border x:Name="BorderIcon"
                                Width="44" Height="44" CornerRadius="22"
                                Background="#22007BFF"
                                BorderBrush="#6D4AFF"
                                BorderThickness="1.5"
                                Margin="0,0,14,0">
                            <TextBlock x:Name="TxtIcon" Text="🧹" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitle" Text="Cleaning Files..." FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="TxtSubtitle" Text="Safely removing selected items" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Current File Label -->
                    <TextBlock x:Name="TxtCurrentFile"
                               Text="Preparing..."
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,8" />

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="PbProgress"
                                 Height="10"
                                 Minimum="0" Maximum="100" Value="0"
                                 Background="{DynamicResource BorderBrush}"
                                 Foreground="{DynamicResource AccentPrimaryBrush}"
                                 Margin="0,0,0,6" />

                    <!-- Progress counters row -->
                    <Grid Margin="0,0,0,14">
                        <TextBlock x:Name="TxtProgressItems" Text="0 / 0 items" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtProgressPct" Text="0%" FontSize="11" Foreground="{DynamicResource AccentGlowBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Summary Card — shown when done -->
                    <Border x:Name="BorderSummary"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,10"
                            Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="TxtSummaryValue" DockPanel.Dock="Left" Text="+ 0 MB"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource StatusSafeBrush}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSummaryLabel" Text="Disk Space Freed" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtSummarySubtext" Text="Verified &amp; safely executed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
